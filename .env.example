# Firestore (via emulator locally, vellum-project in production)
FIREBASE_PROJECT_ID=vellum-project
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Recommended: Groq (free tier, OpenAI-compatible). Get a key at https://console.groq.com
GROQ_API_KEY=
# ...or any other OpenAI-compatible provider (leave commented to use Groq):
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# When GROQ_API_KEY is the only key set, the app defaults to
# AI_BASE_URL=https://api.groq.com/openai/v1 and AI_MODEL=openai/gpt-oss-120b.
