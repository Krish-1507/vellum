// All data access goes through the Admin SDK on the server, which bypasses
// rules. Default-deny is correct: browsers never touch Firestore directly.
// File originals live in browser IndexedDB, not here.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
